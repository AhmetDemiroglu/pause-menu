{
  "expo": {
    "name": "Pause Menu",
    "slug": "gghub",
    "version": "2.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pausemenu",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#14101F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gghub.mobile",
      "buildNumber": "21",
      "usesAppleSignIn": true,
      "entitlements": {
        "aps-environment": "production"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": [
          "en",
          "tr"
        ],
        "CFBundleDevelopmentRegion": "en"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#14101F",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "package": "com.gghub.mobile",
      "versionCode": 21,
      "googleServicesFile": "./android/app/google-services.json",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow Pause Menu to use Face ID to keep your account securely signed in."
        }
      ],
      "expo-localization",
      "expo-font",
      "./plugins/withGradleEncoding",
      "./plugins/withRemoveSystemAlertWindow",
      [
        "expo-notifications",
        {
          "color": "#FF2E88",
          "icon": "./assets/images/android-icon-monochrome.png"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Pause Menu to access your photos for profile picture upload.",
          "cameraPermission": "Allow Pause Menu to access your camera for profile picture upload.",
          "microphonePermission": false
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.850300912540-hjhir657f7iudq7bnffomai8qs9t0ija"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0f5e5cc1-3810-49e4-954e-7bb23f181e24"
      }
    },
    "owner": "ahmetdemiroglu"
  }
}
